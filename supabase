-- =====================================================================
--  Blog comments + reactions  (Supabase / PostgreSQL)
--  Run ONCE: Supabase dashboard -> SQL Editor -> New query -> paste -> Run.
--  Safe to re-run. Contains no secrets.
--
--  Design
--   * Visitors need no account. They call three RPC functions with the public
--     (anon / publishable) key. They can never read or write tables directly.
--   * Comments are PRE-MODERATED: stored as approved = false and become public
--     only after you approve them in Admin -> Comments.
--   * Spam protection: hidden honeypot field, minimum fill time, link limit,
--     duplicate check, per-IP rate limits (IPs are stored only as a salted hash).
--   * Only the admin user you register in `admins` can read pending comments,
--     approve or delete them (Supabase Auth email + password).
-- =====================================================================
create extension if not exists pgcrypto with schema extensions;

-- ---------- tables ----------
create table if not exists public.comments (
  id          bigint generated always as identity primary key,
  article_id  text        not null check (article_id ~ '^[A-Za-z0-9_-]{1,64}$'),
  name        text        not null check (char_length(name) between 1 and 60),
  body        text        not null check (char_length(body) between 2 and 2000),
  approved    boolean     not null default false,
  created_at  timestamptz not null default now(),
  ip_hash     text
);
create index if not exists comments_article_idx on public.comments (article_id, approved, created_at);

create table if not exists public.reactions (
  article_id  text        not null check (article_id ~ '^[A-Za-z0-9_-]{1,64}$'),
  emoji       text        not null check (emoji in ('👍','❤️','👏','🚀','💡')),
  voter       text        not null check (voter ~ '^[A-Za-z0-9-]{16,64}$'),
  created_at  timestamptz not null default now(),
  primary key (article_id, emoji, voter)
);

create table if not exists public.rate_events (
  id          bigint generated always as identity primary key,
  kind        text        not null,
  ip_hash     text        not null,
  created_at  timestamptz not null default now()
);
create index if not exists rate_events_idx  on public.rate_events (kind, ip_hash, created_at);
create index if not exists rate_events_time on public.rate_events (created_at);

create table if not exists public.admins     (user_id uuid primary key);
create table if not exists public.app_config (key text primary key, value text not null);
insert into public.app_config (key, value)
  values ('ip_salt', encode(extensions.gen_random_bytes(16), 'hex'))
  on conflict (key) do nothing;

-- ---------- lock everything down ----------
alter table public.comments    enable row level security;
alter table public.reactions   enable row level security;
alter table public.rate_events enable row level security;
alter table public.admins      enable row level security;
alter table public.app_config  enable row level security;

revoke all on public.comments, public.reactions, public.rate_events, public.admins, public.app_config
  from anon, authenticated;

-- public may read APPROVED comments only, and only these columns (never ip_hash)
grant select (id, article_id, name, body, created_at) on public.comments to anon;
drop policy if exists comments_public_read on public.comments;
create policy comments_public_read on public.comments for select to anon using (approved);

-- ---------- helpers ----------
create or replace function public.is_admin() returns boolean
language sql stable security definer set search_path = public as $$
  select exists (select 1 from public.admins where user_id = auth.uid());
$$;
revoke all on function public.is_admin() from public;
grant execute on function public.is_admin() to authenticated;

-- admin (signed-in user listed in `admins`) may read all comments, approve, delete
grant select (id, article_id, name, body, approved, created_at), update (approved), delete
  on public.comments to authenticated;
drop policy if exists comments_admin_read   on public.comments;
drop policy if exists comments_admin_update on public.comments;
drop policy if exists comments_admin_delete on public.comments;
create policy comments_admin_read   on public.comments for select to authenticated using (public.is_admin());
create policy comments_admin_update on public.comments for update to authenticated using (public.is_admin()) with check (public.is_admin());
create policy comments_admin_delete on public.comments for delete to authenticated using (public.is_admin());

-- salted hash of the caller's IP (cf-connecting-ip cannot be spoofed by the client);
-- returns '' when no IP is available, in which case IP rate limits are skipped
create or replace function public.client_ip_hash() returns text
language plpgsql stable security definer set search_path = public, extensions as $$
declare h json; ip text; salt text;
begin
  begin h := current_setting('request.headers', true)::json; exception when others then h := null; end;
  ip := coalesce(nullif(h->>'cf-connecting-ip',''), nullif(trim(split_part(coalesce(h->>'x-forwarded-for',''), ',', 1)),''), '');
  if ip = '' then return ''; end if;
  select value into salt from public.app_config where key = 'ip_salt';
  return encode(extensions.digest(ip || ':' || coalesce(salt,''), 'sha256'), 'hex');
end $$;
revoke all on function public.client_ip_hash() from public;

-- ---------- submit a comment (always stored UNAPPROVED) ----------
create or replace function public.submit_comment(
  p_article text, p_name text, p_body text, p_hp text default '', p_elapsed integer default 0
) returns jsonb
language plpgsql security definer set search_path = public, extensions as $$
declare iph text := public.client_ip_hash(); nm text := btrim(coalesce(p_name,'')); bd text := btrim(coalesce(p_body,''));
begin
  if coalesce(p_hp,'') <> '' then return jsonb_build_object('ok', true, 'status', 'pending'); end if;   -- bot: pretend success
  if p_article is null or p_article !~ '^[A-Za-z0-9_-]{1,64}$' then return jsonb_build_object('ok', false, 'error', 'invalid'); end if;
  if char_length(nm) not between 1 and 60 or char_length(bd) not between 2 and 2000 then return jsonb_build_object('ok', false, 'error', 'invalid'); end if;
  if coalesce(p_elapsed,0) < 3000 then return jsonb_build_object('ok', false, 'error', 'too_fast'); end if;
  if (select count(*) from regexp_matches(lower(bd), 'https?:|www\.', 'g')) > 2 then return jsonb_build_object('ok', false, 'error', 'links'); end if;
  if exists (select 1 from public.comments where article_id = p_article and lower(body) = lower(bd) and created_at > now() - interval '1 day') then
    return jsonb_build_object('ok', false, 'error', 'duplicate');
  end if;
  if iph <> '' then
    delete from public.rate_events where created_at < now() - interval '2 days';
    if (select count(*) from public.rate_events where kind='comment' and ip_hash=iph and created_at > now() - interval '30 seconds') >= 1
       or (select count(*) from public.rate_events where kind='comment' and ip_hash=iph and created_at > now() - interval '1 hour') >= 5 then
      return jsonb_build_object('ok', false, 'error', 'rate_limited');
    end if;
    insert into public.rate_events (kind, ip_hash) values ('comment', iph);
  end if;
  insert into public.comments (article_id, name, body, approved, ip_hash) values (p_article, nm, bd, false, nullif(iph,''));
  return jsonb_build_object('ok', true, 'status', 'pending');
end $$;

-- ---------- reactions ----------
create or replace function public.reaction_counts(p_article text) returns jsonb
language sql stable security definer set search_path = public as $$
  select coalesce(jsonb_object_agg(e, coalesce(c.n, 0)), '{}'::jsonb)
  from unnest(array['👍','❤️','👏','🚀','💡']) as e
  left join (select emoji, count(*) n from public.reactions where article_id = p_article group by emoji) c on c.emoji = e;
$$;

create or replace function public.toggle_reaction(p_article text, p_emoji text, p_voter text) returns jsonb
language plpgsql security definer set search_path = public, extensions as $$
declare iph text := public.client_ip_hash(); n integer; was boolean;
begin
  if p_article is null or p_article !~ '^[A-Za-z0-9_-]{1,64}$'
     or p_emoji is null or p_emoji not in ('👍','❤️','👏','🚀','💡')
     or p_voter is null or p_voter !~ '^[A-Za-z0-9-]{16,64}$' then
    return jsonb_build_object('ok', false, 'error', 'invalid');
  end if;
  if iph <> '' then
    if (select count(*) from public.rate_events where kind='react' and ip_hash=iph and created_at > now() - interval '10 minutes') >= 40 then
      return jsonb_build_object('ok', false, 'error', 'rate_limited');
    end if;
    insert into public.rate_events (kind, ip_hash) values ('react', iph);
  end if;
  delete from public.reactions where article_id = p_article and emoji = p_emoji and voter = p_voter;
  get diagnostics n = row_count;
  was := n > 0;
  if not was then insert into public.reactions (article_id, emoji, voter) values (p_article, p_emoji, p_voter); end if;
  return jsonb_build_object('ok', true, 'on', not was, 'counts', public.reaction_counts(p_article));
end $$;

revoke all on function public.submit_comment(text,text,text,text,integer), public.reaction_counts(text), public.toggle_reaction(text,text,text) from public;
grant execute on function public.submit_comment(text,text,text,text,integer), public.reaction_counts(text), public.toggle_reaction(text,text,text) to anon, authenticated;

